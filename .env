# --- SERVER CONFIG ---
PORT=3000

# --- META/INSTAGRAM API KEYS ---
# Get these from https://developers.facebook.com/apps
APP_ID=your_app_id
APP_SECRET=your_app_secret
USER_ACCESS_TOKEN=your_short_lived_user_token
PAGE_ACCESS_TOKEN=your_long_lived_page_token
IG_USER_ID=your_instagram_business_account_id

# --- WEBHOOK CONFIG ---
# You choose this! It must match what you put in Meta App Dashboard
VERIFY_TOKEN=tapinbox_secret_token_123

# --- API VERSION ---
API_VERSION=v23.0
GRAPH_HOST=https://graph.facebook.com
